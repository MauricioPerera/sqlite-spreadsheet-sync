# === SQLite Spreadsheet Sync — variables de entorno ===
# Copia este archivo a `.env` y ajusta los valores.
# En desarrollo local puedes dejarlo vacío: la app arranca sin autenticación.

# Puerto del backend Express (por defecto 3001)
PORT=3001

# --- Seguridad (recomendado en producción) ---

# Si se define, TODA petición a /api/** debe enviar el header `x-api-key` con este valor.
# Si se deja vacío/sin definir, la API queda ABIERTA (solo apto para desarrollo local).
API_KEY=

# Origen permitido para CORS. Por defecto: http://localhost:3000
# En producción, apúntalo al dominio real del frontend (ej. https://app.midominio.com)
ALLOWED_ORIGIN=http://localhost:3000
